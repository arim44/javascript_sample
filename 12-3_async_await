//async/await
async function func1(){
    return 'hello';
}
func1().then(console.log);

function func2(){
    return new Promise((resolve)=> resolve('hello'));
}
func2().then(console.log);

// 값을 가지고 올때까지 기다리게
async function func3(){
    // await는 뒤에 오는 프로미스가 실행 완료될때까지 기다림
    // async함수에서만 사용가능
    let name = await func1();
    console.log(name);
}
func3();

