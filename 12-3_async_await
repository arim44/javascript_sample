// 메인
const url= 'http://raw.githubusercontent.com/wapj/jsbackend/main/movieinfo.json';

// 영화정보 전체 로직 함수
async function  movies() {
    try{
        // 데이터 가져오기(fetch)
        const data = await fetchMovieData(url); // 데이터 가져올때 까지 대기 했다가 가져오면 data 에 대입
        // 데이터 검증
        validataMovieData(data);
        // 영화 정보 추출
        const movieInfos = extractMovieInfos(data.articleList);
        // 영화 출력
        displayMovies(movieInfos);
    }catch (err){   // 에러시 실행
        console.error('에러 발생', err.message);
    }
}
// 전체 로직 함수 호출
movies();


