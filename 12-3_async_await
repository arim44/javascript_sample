//async/await - 영화정보
//1. 데이터 가져오기(fetch) => 비동기가 필요함
async function fetchMovieData(url){
    const response = await fetch(url);  // url가져오기 요청 가져올때까지 기다렸다가 넣음
    // 통신이 잘되지 않으면 에러실행
    if(!response.ok){   // response.ok : http코드 200(통신이 잘됨)
        throw new Error('요청에 실패. 상태코드: ' + response.status);
    }
    // response.json() 실행될때까지 기다렸다가 넣음
    const data = await response.json(); // 프로미스
    // data 반환
    return data;
}

